{
  "expo": {
    "name": "Quaru",
    "slug": "app-academia",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app-academia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.domma.academia"
    },
    "android": {
      "package": "br.com.domma.academia",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#1A0E12"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Quaru",
      "shortName": "Quaru",
      "lang": "pt-BR",
      "themeColor": "#F2A0B0",
      "backgroundColor": "#F2A0B0",
      "description": "Quaru: registro de treinos no seu aparelho."
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sons/descanso.wav"
          ],
          "color": "#E0263F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A0E12"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      "./plugins/sem-backup-android",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Quaru usa a galeria só quando você escolhe uma foto de perfil. A foto fica neste aparelho.",
          "cameraPermission": "O Quaru usa a câmera só quando você tira uma foto de perfil. A foto fica neste aparelho.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true,
      "baseUrl": "/quaru"
    },
    "extra": {
      "observacao": "Nome exibido: Quaru (PROVISÓRIO, sujeito a análise jurídica; definido em src/config/marca.ts e aqui em expo.name). Identificador br.com.domma.academia e slug app-academia aguardam decisão."
    }
  }
}
